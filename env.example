# Copy to .env.local if needed. https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Optional: override default User-Agent for outbound HTML fetches (Eventbrite, 19hz, etc.).
SCRAPE_USER_AGENT=

# Optional: extra 19hz (or compatible) listing URLs, space or comma separated.
# NINETEEN_HZ_URLS=https://19hz.info/eventlisting_BayArea.php

# Optional: directory for profile.json (CLI and Next app both use this when set).
# PLUR_DATA_DIR=./data
