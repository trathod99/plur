# Copy to .env.local and fill in. https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=
BANDSINTOWN_APP_ID=

# Electronic-first listings (apply at https://edmtrain.com/developer-api — review their API terms).
EDMTRAIN_CLIENT=
# Optional override if auto lookup fails (integer from Edmtrain Locations API).
EDMTRAIN_SF_LOCATION_ID=
# Optional comma-separated Edmtrain venue ids for SF warehouses / clubs you care about.
EDMTRAIN_SF_VENUE_IDS=

# Broader Bay Area calendar (request a key at https://www.songkick.com/api_key_requests/new).
SONGKICK_API_KEY=
